# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DEBUG=false
SERVICE_NAME=app
SERVICE_TITLE=FastAPI Boilerplate
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars. Production refuses this example value.
JWT_SECRET=dev-only-secret-replace-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# One retry of an already-rotated refresh token is allowed inside this
# window (network retries). A second one revokes the whole family. 0 = off.
REFRESH_REUSE_GRACE_SECONDS=30

# Redis: rate limiting + Celery broker/result backend.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2.0

# Cookie signing key for the /admin panel session. Set a separate random
# value in production; falls back to JWT_SECRET when empty.
ADMIN_SESSION_SECRET=
# Panel cookie lifetime (seconds). Keep it short: it is a second auth surface.
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# JSON list. Empty = no CORS middleware. Production requires explicit origins.
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1000000
# Uploads stream to disk with their own cap (services/upload.py).
MAX_UPLOAD_BYTES=52428800
UPLOAD_DIR=uploads
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
